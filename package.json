{
	"name": "caseyagollan-com",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "git submodule update --init --recursive || true",
		"build": "bun run build:search && vite build",
		"preview": "bun run build && wrangler dev",
		"preview:remote": "bun run build && wrangler dev --remote",
		"deploy": "bun run build && wrangler deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"backfill-social-snapshots": "bun utils/backfill-social-snapshots.ts",
		"update-library": "bun utils/librarything-to-graph.js",
		"build:search": "bun utils/build-search.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251011.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@types/bun": "^1.4.4",
		"@types/d3-drag": "^3",
		"@types/d3-ease": "^3",
		"@types/d3-force": "^3",
		"@types/d3-selection": "^3",
		"@types/d3-transition": "^3",
		"@types/three": "^0.180.0",
		"mdsvex": "^0.12.6",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"wrangler": "^4.43.0",
		"pagefind": "1.6.0"
	},
	"dependencies": {
		"3d-force-graph": "^1.79.0",
		"@ipld/car": "5.4.7",
		"@ipld/dag-cbor": "10.0.2",
		"@pagefind/component-ui": "1.6.0",
		"@simplewebauthn/browser": "14.0.0",
		"@simplewebauthn/server": "14.0.3",
		"d3-drag": "^3.0.0",
		"d3-ease": "^3.0.1",
		"d3-force": "^3.0.0",
		"d3-selection": "^3.0.0",
		"d3-transition": "^3.0.1",
		"hast-util-from-html": "2.0.3",
		"hast-util-sanitize": "5.0.2",
		"hast-util-to-html": "9.0.5",
		"marked": "^16.4.1",
		"openai": "^4.77.0",
		"three": "^0.180.0",
		"three-spritetext": "^1.10.0",
		"yaml": "^2.9.1"
	}
}
