/**
 * Cloudflare Workers configuration for caseyagollan.com
 * https://developers.cloudflare.com/workers/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "caseyagollan",
	"main": "worker.mjs",
	"durable_objects": {
		"bindings": [
			{ "name": "AUTH_STORE", "class_name": "IndieAuthStore" },
			{ "name": "ChatThread", "class_name": "ChatThread" },
			// Live cursors and cursor chat, one object per page (src/lib/server/cursors/room.ts).
			{ "name": "CURSORS", "class_name": "CursorRoom" }
		]
	},
	"migrations": [
		{ "tag": "v1-indieauth", "new_sqlite_classes": ["IndieAuthStore"] },
		/** /chat threads: one Agents SDK agent per thread (src/lib/server/chat/agent.ts). */
		{ "tag": "v2-chat", "new_sqlite_classes": ["ChatThread"] },
		{ "tag": "v3-cursors", "new_sqlite_classes": ["CursorRoom"] }
	],
	"compatibility_date": "2025-01-19",
	"compatibility_flags": [
		"nodejs_als",
		/** The Agents SDK (/chat) needs Node.js APIs. */
		"nodejs_compat", "enable_weak_ref"
	],
	/**
	 * Enable workers.dev subdomain for preview deployments
	 */
	"workers_dev": true,
	"triggers": { "crons": ["*/5 * * * *"] },
	"vars": {
		"AUTH_ENABLED": "true",
		"AUTH_ORIGIN": "https://caseyagollan.com/",
		"AUTH_ME": "https://caseyagollan.com/",
		"PUBLISHING_AUTH_MODE": "internal",
		"PUBLISHING_ENABLED": "true",
		"PESOS_ENABLED": "true",
		"PUBLISHING_DELIVERY_ENABLED": "false",
		"WEBSUB_ENABLED": "true",
		"PUBLISHING_MEDIA_BASE_URL": "https://files.caseyagollan.com/",
		"PUBLISHING_ME": "https://caseyagollan.com/",
		"PUBLISHING_INTROSPECTION_ENDPOINT": "https://kit.caseyagollan.com/auth/introspect",
		"PUBLISHING_GITHUB_OWNER": "caseyg",
		"PUBLISHING_GITHUB_REPO": "caseyagollan-content",
		"PUBLISHING_GITHUB_BRANCH": "main",
		"PUBLISHING_DRAFTS_GITHUB_REPO": "caseyagollan-drafts",
		"PUBLISHING_DRAFTS_GITHUB_BRANCH": "main",
		"PUBLISHING_TIMEZONE": "America/New_York",
		"PUBLISHING_MASTODON_INSTANCE": "https://social.coop",
		"PUBLISHING_BLUESKY_SERVICE": "https://bsky.social",
		"PUBLISHING_BLUESKY_IDENTIFIER": "caseyagollan.com",
		/** The inference.coop model /chat answers with (key: the INFERENCE_COOP_API_KEY secret). */
		"CHAT_MODEL": "glm-flash-green",
		/** US dollars each /chat visitor may spend a month (Casey is not capped). */
		"CHAT_MONTHLY_BUDGET": "3"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	/**
	 * Cloudflare Images shrinks photos too large for a social network (Bluesky takes
	 * 1 MB per image) when a post is syndicated.
	 */
	"images": { "binding": "IMAGES" },
	/**
	 * Per-visitor limits on the endpoints anyone can call that cost money or fetch other sites
	 * (src/lib/server/rate-limit.ts): model calls for the homepage's insights and bio, and fresh
	 * screenshots. Counted per address at each Cloudflare location; not a spending cap.
	 */
	"ratelimits": [
		{ "name": "AI_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 12, "period": 60 } },
		{ "name": "FETCH_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } }
	],
	/**
	 * Enable preview URLs for branch deployments
	 */
	"preview_urls": true,
	/**
	 * Worker Previews (`wrangler preview`) for non-production branches.
	 * Version URLs from `wrangler versions upload` are not generated for Workers
	 * that implement a Durable Object, so branch builds use Previews instead.
	 * Previews inherit nothing from the settings above except assets and
	 * compatibility settings, and each Preview gets its own AUTH_STORE namespace.
	 * Passkeys are bound to the production hostname, so Casey signs in to a preview
	 * through production instead: AUTH_PREVIEW_ISSUER makes the preview an IndieAuth
	 * client of caseyagollan.com (src/lib/server/indieauth/preview.ts). The preview
	 * holds no passkeys and issues no tokens. Publishing and imports stay off: previews
	 * must not write content or post socially.
	 * Media, screenshots, and the insight cache are read from production.
	 * Secrets are not inherited either: a new Preview copies the Worker's Previews Base secrets
	 * (`npx wrangler preview base-config secret list`), which is where /chat's INFERENCE_COOP_API_KEY,
	 * KAGI_API_KEY and the ARENA_PAT, RAINDROP_TOKEN and READWISE_ACCESS_TOKEN read tokens live. A Preview
	 * made before a secret was added there needs `npx wrangler preview secret put <KEY> --name <preview>`.
	 * Publishing and syndication tokens must never be added to Previews Base.
	 */
	"previews": {
		"durable_objects": { "bindings": [{ "name": "AUTH_STORE", "class_name": "IndieAuthStore" }, { "name": "ChatThread", "class_name": "ChatThread" }, { "name": "CURSORS", "class_name": "CursorRoom" }] },
		/** AUTH_ISSUER is production itself: a preview redeems sign-in codes through it, since fetching caseyagollan.com from this script never reaches it. */
		"services": [{ "binding": "STORYBOOK", "service": "caseyagollan-storybook" }, { "binding": "AUTH_ISSUER", "service": "caseyagollan" }],
		"vars": {
			"AUTH_ENABLED": "true",
			"AUTH_ME": "https://caseyagollan.com/",
			"AUTH_PREVIEW_ISSUER": "https://caseyagollan.com/",
			"PUBLISHING_ENABLED": "false",
			"PESOS_ENABLED": "false",
			"PUBLISHING_DELIVERY_ENABLED": "false",
			"PUBLISHING_MEDIA_BASE_URL": "https://files.caseyagollan.com/",
			"PUBLISHING_ME": "https://caseyagollan.com/",
			"PUBLISHING_TIMEZONE": "America/New_York",
			"CHAT_MODEL": "glm-flash-green",
			"CHAT_MONTHLY_BUDGET": "3"
		},
		"kv_namespaces": [{ "binding": "INSIGHT_CACHE", "id": "9eca3bf2742740d78191c5be95a5be97" }],
		"ratelimits": [
			{ "name": "AI_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 12, "period": 60 } },
			{ "name": "FETCH_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } }
		],
		"r2_buckets": [
			{ "binding": "PUBLISHING_STATE", "bucket_name": "caseyagollan-publishing-state-preview" },
			{ "binding": "PUBLISHING_MEDIA", "bucket_name": "caseyagollan-content" },
			{ "binding": "SCREENSHOTS", "bucket_name": "caseyagollan-content" }
		]
	},
	/**
	 * Storybook is its own Worker (wrangler.storybook.jsonc), built only when code changes,
	 * and worker.mjs forwards /storybook/ to it. Content publishes skip building it.
	 */
	"services": [{ "binding": "STORYBOOK", "service": "caseyagollan-storybook" }],
	/**
	 * Custom domain routing
	 */
	"routes": [
		{
			"pattern": "caseyagollan.com/*",
			"zone_name": "caseyagollan.com"
		}
	],
	/**
	 * KV Namespace for caching AI insights
	 * Using the same namespace for both dev and production
	 * Use `wrangler dev --remote` to test against real KV
	 */
	"kv_namespaces": [
		{
			"binding": "INSIGHT_CACHE",
			"id": "9eca3bf2742740d78191c5be95a5be97",
			"preview_id": "9eca3bf2742740d78191c5be95a5be97"
		}
	],
	/**
	 * R2 bucket for caching website screenshots
	 */
	"r2_buckets": [
		{ "binding": "PUBLISHING_STATE", "bucket_name": "caseyagollan-publishing-state" },
		{
			"binding": "PUBLISHING_MEDIA",
			"bucket_name": "caseyagollan-content"
		},
		{
			"binding": "SCREENSHOTS",
			"bucket_name": "caseyagollan-content"
		}
	]
}
