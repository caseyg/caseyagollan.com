/**
 * Cloudflare Workers configuration for caseyagollan.com
 * https://developers.cloudflare.com/workers/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "caseyagollan",
	"main": "worker.mjs",
	"durable_objects": { "bindings": [{ "name": "AUTH_STORE", "class_name": "IndieAuthStore" }] },
	"migrations": [{ "tag": "v1-indieauth", "new_sqlite_classes": ["IndieAuthStore"] }],
	"compatibility_date": "2025-01-19",
	"compatibility_flags": [
		"nodejs_als"
	],
	/**
	 * Enable workers.dev subdomain for preview deployments
	 */
	"workers_dev": true,
	"triggers": { "crons": ["*/5 * * * *"] },
	"vars": {
		"AUTH_ENABLED": "true",
		"AUTH_ORIGIN": "https://caseyagollan.com/",
		"AUTH_ME": "https://caseyagollan.com/",
		"PUBLISHING_AUTH_MODE": "internal",
		"PUBLISHING_ENABLED": "true",
		"PESOS_ENABLED": "true",
		"PUBLISHING_DELIVERY_ENABLED": "false",
		"PUBLISHING_MEDIA_BASE_URL": "https://files.caseyagollan.com/",
		"PUBLISHING_ME": "https://caseyagollan.com/",
		"PUBLISHING_INTROSPECTION_ENDPOINT": "https://kit.caseyagollan.com/auth/introspect",
		"PUBLISHING_GITHUB_OWNER": "caseyg",
		"PUBLISHING_GITHUB_REPO": "caseyagollan-content",
		"PUBLISHING_GITHUB_BRANCH": "main",
		"PUBLISHING_TIMEZONE": "America/New_York",
		"PUBLISHING_MASTODON_INSTANCE": "https://social.coop",
		"PUBLISHING_BLUESKY_SERVICE": "https://bsky.social",
		"PUBLISHING_BLUESKY_IDENTIFIER": "caseyagollan.com"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	/**
	 * Enable preview URLs for branch deployments
	 */
	"preview_urls": true,
	/**
	 * Custom domain routing
	 */
	"routes": [
		{
			"pattern": "caseyagollan.com/*",
			"zone_name": "caseyagollan.com"
		}
	],
	/**
	 * KV Namespace for caching AI insights
	 * Using the same namespace for both dev and production
	 * Use `wrangler dev --remote` to test against real KV
	 */
	"kv_namespaces": [
		{
			"binding": "INSIGHT_CACHE",
			"id": "9eca3bf2742740d78191c5be95a5be97",
			"preview_id": "9eca3bf2742740d78191c5be95a5be97"
		}
	],
	/**
	 * R2 bucket for caching website screenshots
	 */
	"r2_buckets": [
		{ "binding": "PUBLISHING_STATE", "bucket_name": "caseyagollan-publishing-state" },
		{
			"binding": "PUBLISHING_MEDIA",
			"bucket_name": "caseyagollan-content"
		},
		{
			"binding": "SCREENSHOTS",
			"bucket_name": "caseyagollan-content"
		}
	]
}
