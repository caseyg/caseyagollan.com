# WebSub discovery (rel="hub" and rel="self") for the prerendered feeds. SvelteKit's Cloudflare
# adapter appends its own rules to this file in the build output.
/feed.xml
  Link: <https://pubsubhubbub.appspot.com/>; rel="hub", <https://caseyagollan.com/feed.xml>; rel="self"
/atom.xml
  Link: <https://pubsubhubbub.appspot.com/>; rel="hub", <https://caseyagollan.com/atom.xml>; rel="self"
/feed.json
  Link: <https://pubsubhubbub.appspot.com/>; rel="hub", <https://caseyagollan.com/feed.json>; rel="self"

# Security headers for the prerendered pages and other static files, which never pass through the
# Worker's hook (src/lib/server/security-headers.ts sets the same on everything it renders):
# HTTPS only, no MIME sniffing, no framing by other sites, no plugins or <base> tricks.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(self), payment=(), usb=(), geolocation=(self)
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'self'

# The table view Claude shows (an MCP App) runs in Claude's sandbox, at an address that isn't the
# site's, and loads its script, the search index and each post's source from here. All of it is
# public already; this lets a page elsewhere read it, without cookies.
/mcp-app/*
  Access-Control-Allow-Origin: *
/pagefind/*
  Access-Control-Allow-Origin: *
/:year/:month/:day/:slug/source.json
  Access-Control-Allow-Origin: *
